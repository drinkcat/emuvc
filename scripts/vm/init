#!/bin/busybox sh
# PID 1 inside the throwaway VM (see docs/VM.md).
export PATH=/bin:/sbin
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
exec </dev/console >/dev/console 2>&1

# kernel cmdline: emuvc_script=<base64> emuvc_verbose=0|1
for w in $(cat /proc/cmdline); do
    case "$w" in
        emuvc_script=*) SCRIPT_B64=${w#emuvc_script=} ;;
    esac
done

die() { echo "vm-init: $*" >&2; echo "@@EMUVC_RC=125"; poweroff -f; sleep 100; }

for m in $(cat /mods/list); do
    insmod "/mods/$m" || die "insmod $m failed"
done
mkdir -p /mnt
mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=1048576 hostroot /mnt \
    || die "cannot mount host root over 9p"

# Writable scratch areas; the host filesystem itself stays read-only.
mount -t tmpfs -o mode=1777 tmpfs /mnt/tmp
mount -t tmpfs -o mode=755 tmpfs /mnt/run
mount -t tmpfs -o mode=1777 tmpfs /mnt/var/tmp
mount -t proc proc /mnt/proc
mount -t sysfs sys /mnt/sys
mount -t devtmpfs dev /mnt/dev
mkdir -p /mnt/dev/pts /mnt/dev/shm
mount -t devpts devpts /mnt/dev/pts 2>/dev/null
mount -t tmpfs tmpfs /mnt/dev/shm
mount -t debugfs debugfs /mnt/sys/kernel/debug 2>/dev/null
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up
hostname emuvc-vm

echo "$SCRIPT_B64" | base64 -d > /tmp-script 2>/dev/null
cp /tmp-script /mnt/tmp/.vm-script.sh
chroot /mnt /usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin \
    HOME=/tmp TERM=dumb USER=root LANG=C \
    /bin/sh /tmp/.vm-script.sh </dev/null
rc=$?
if [ $rc -ne 0 ]; then
    echo "--- vm-run: command failed (rc=$rc); last dmesg lines ---" >&2
    dmesg | tail -n 25 >&2
fi
echo "@@EMUVC_RC=$rc"
poweroff -f
sleep 100
